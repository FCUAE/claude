generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id             String   @id @default(uuid())
  name           String
  tagline        String?
  description    String?
  url            String?
  thumbnailUrl   String?  @map("thumbnail_url")
  productHuntUrl String?  @map("product_hunt_url")
  productHuntId  String?  @map("product_hunt_id")
  topics         String?  // JSON array of tags
  createdAt      DateTime @default(now()) @map("created_at")

  dailySnapshots DailySnapshot[]
  rawMentions    RawMention[]

  @@map("products")
}

model DailySnapshot {
  id                 String   @id @default(uuid())
  snapshotDate       String   @map("snapshot_date") // YYYY-MM-DD
  productId          String   @map("product_id")
  rank               Int
  pmfScore           Float    @map("pmf_score")
  upvoteVelocity     Float    @map("upvote_velocity")
  commentEngagement  Float    @map("comment_engagement")
  sentimentSignal    Float    @map("sentiment_signal")
  crossPlatform      Boolean  @map("cross_platform")
  topicRelevance     Float    @map("topic_relevance")
  recencyBoost       Float    @map("recency_boost")
  vibecodeScore      Int      @map("vibecode_score")
  vibecodeBreakdown  String?  @map("vibecode_breakdown") // JSON
  founderFitCategory String?  @map("founder_fit_category") // e.g. "Dev Tools", "GTM & Sales"
  phUpvotes          Int      @default(0) @map("ph_upvotes")
  phComments         Int      @default(0) @map("ph_comments")
  redditUpvotes      Int      @default(0) @map("reddit_upvotes")
  redditComments     Int      @default(0) @map("reddit_comments")
  redditSubreddits   String?  @map("reddit_subreddits") // JSON array
  createdAt          DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("daily_snapshots")
}

model RawMention {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  source    String   // "producthunt" | "reddit"
  sourceUrl String?  @map("source_url")
  sourceId  String?  @map("source_id")
  upvotes   Int      @default(0)
  comments  Int      @default(0)
  bodyText  String?  @map("body_text")
  postedAt  DateTime? @map("posted_at")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("raw_mentions")
}
